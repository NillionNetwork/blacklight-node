# Sepolia deployment secrets (P1.M5).
# Copy to devnet/sepolia.env (gitignored) and fill in. Everything else
# (keeper/node/submitter wallets) is generated and funded from this key.

# Funded deployer key (2-5 Sepolia ETH recommended)
SEPOLIA_PRIVATE_KEY=

# RPC endpoint with WebSocket support. The https URL is enough; the node/keeper
# derive wss:// from it. Verified working public endpoints (2026-07-07):
#   https://ethereum-sepolia-rpc.publicnode.com   (primary recommendation)
#   https://sepolia.drpc.org                      (fallback)
# For the 2-week soak a dedicated free-tier Alchemy/Infura key is still safer
# against public-endpoint throttling, but PublicNode is fine to start.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
