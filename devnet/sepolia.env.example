# Sepolia deployment secrets (P1.M5).
# Copy to devnet/sepolia.env (gitignored) and fill in. Everything else
# (keeper/node/submitter wallets) is generated and funded from this key.

# Funded deployer key (2-5 Sepolia ETH recommended)
SEPOLIA_PRIVATE_KEY=

# RPC endpoint with WebSocket support (Alchemy/Infura style).
# Provide the https URL; the node/keeper derive wss:// from it.
SEPOLIA_RPC_URL=
